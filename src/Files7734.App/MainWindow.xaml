<Window x:Class="Files7734.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Files7734.App"
        Title="7734 Files Checker" Height="840" Width="1380" MinWidth="900" MinHeight="560"
        Icon="app.ico" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource SidebarBrush}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═════════ Barre latérale (translucide sous Windows 11) ═════════ -->
        <DockPanel Grid.Column="0" Margin="12,0,10,14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,18,0,22">
                <Image Source="app.ico" Width="28" Height="28" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="7734 Files Checker" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Analyseur d'espace disque" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                </StackPanel>
            </StackPanel>

            <!-- Bas de la barre latérale : mode admin -->
            <Border DockPanel.Dock="Bottom" x:Name="AdminBanner" Background="{DynamicResource WarningBgBrush}" CornerRadius="10" Padding="12,10" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource WarningTextBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Mode classique" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="AdminBannerText" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                               Text="Sans les droits administrateur, le scan est plus lent."/>
                    <Button Style="{StaticResource LinkButton}" Margin="-10,4,0,-6" Click="RestartAdmin_Click" HorizontalAlignment="Left">
                        <TextBlock Text="Relancer en administrateur" FontSize="12" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,10">
                <Button x:Name="FolderButton" Style="{StaticResource LinkButton}" Click="FolderButton_Click" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Analyser un dossier…" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="Outils" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}" Margin="10,0,0,6"/>
            <ListBox x:Name="NavList" DockPanel.Dock="Top" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource SidebarItem}"
                     Margin="0,0,0,16" SelectionChanged="NavList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Visibility="{Binding BadgeVisibility}">
                                <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,11,0"/>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock DockPanel.Dock="Top" Text="Disques" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}" Margin="10,0,0,6"/>
            <ListBox x:Name="DriveList" Style="{StaticResource PlainListBox}" ItemContainerStyle="{StaticResource SidebarItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="DriveList_MouseDoubleClick" SelectionChanged="DriveList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="{Binding Letter, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                                </TextBlock>
                                <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" Margin="0,6,0,5" Width="150" HorizontalAlignment="Left">
                                    <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="2" Background="{Binding BarBrush}"/>
                                </Border>
                                <TextBlock Text="{Binding UsageText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ═════════ Zone principale ═════════ -->
        <Border Grid.Column="1" Background="{DynamicResource ContentBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="22,0,22,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Barre de menus + boutons de fenêtre (zone de déplacement de la fenêtre) -->
                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,-22,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Réduire"/>
                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Agrandir"/>
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fermer"/>
                    </StackPanel>
                    <Menu x:Name="MainMenu" Margin="-10,8,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </DockPanel>

                <!-- Barre d'outils (sert aussi de barre de titre) -->
                <DockPanel Grid.Row="1" Margin="0,4,0,16">

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <StackPanel VerticalAlignment="Center" Width="230" Margin="0,0,14,0">
                            <TextBlock x:Name="ProgressText" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                            <ProgressBar x:Name="Progress" Margin="0,6,0,0" Minimum="0" Maximum="1" Visibility="Collapsed"/>
                        </StackPanel>
                        <Button x:Name="CancelButton" Style="{StaticResource PlainButton}" Click="CancelButton_Click" Visibility="Collapsed" Content="Annuler" Margin="0,0,8,0"/>
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Width="220" Margin="0,0,10,0"
                                 Tag="Rechercher (ex. *.mp4)" KeyDown="SearchBox_KeyDown" ToolTip="Entrée pour chercher, Échap pour effacer"/>
                        <Button x:Name="ScanButton" Style="{StaticResource AccentButton}" Click="ScanButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Analyser"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Top">
                        <TextBlock x:Name="HeaderTitle" Text="Bienvenue" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="HeaderSub" Text="Choisis un disque à gauche puis clique sur Analyser." Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        <!-- Résumé du disque -->
                        <WrapPanel x:Name="DriveStats" Margin="0,12,0,0" Visibility="Collapsed">
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,7" Margin="0,0,10,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <StackPanel><TextBlock Text="Espace total" Style="{StaticResource StatLabel}"/><TextBlock x:Name="StatTotal" Style="{StaticResource StatValue}"/></StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,7" Margin="0,0,10,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Espace utilisé" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Style="{StaticResource StatValue}"><Run x:Name="StatUsed"/><Run x:Name="StatUsedPct" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,7" Margin="0,0,10,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Espace libre" Style="{StaticResource StatLabel}"/>
                                    <TextBlock Style="{StaticResource StatValue}" Foreground="{DynamicResource SuccessBrush}"><Run x:Name="StatFree"/><Run x:Name="StatFreePct" FontWeight="Normal" Foreground="{DynamicResource MutedBrush}" FontSize="12"/></TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="14,7" Margin="0,0,10,0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    ToolTip="Espace utilisé par Windows mais non visible dans les fichiers (réserve système, métadonnées…)">
                                <StackPanel><TextBlock Text="Espace réservé" Style="{StaticResource StatLabel}"/><TextBlock x:Name="StatReserved" Style="{StaticResource StatValue}"/></StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>

                <Grid x:Name="AnalysisPage" Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="5*" MinHeight="140"/>
                        <RowDefinition x:Name="RowSplit" Height="16"/>
                        <RowDefinition x:Name="RowMap" Height="4*" MinHeight="120"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" MinWidth="300"/>
                        <ColumnDefinition x:Name="ColSplit" Width="16"/>
                        <ColumnDefinition x:Name="ColSide" Width="2*" MinWidth="260"/>
                    </Grid.ColumnDefinitions>

                    <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="0,2,0,8">
                        <ListView x:Name="TreeList" SelectionMode="Single" SelectionChanged="TreeList_SelectionChanged"
                                  KeyDown="TreeList_KeyDown" MouseDoubleClick="TreeList_MouseDoubleClick" ContextMenuOpening="List_ContextMenuOpening">
                            <ListView.ContextMenu><ContextMenu/></ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nom" Width="330">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                                    <ToggleButton Style="{StaticResource ExpanderToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                  Visibility="{Binding ExpanderVisibility}"/>
                                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" Foreground="{Binding IconBrush}"
                                                               VerticalAlignment="Center" Margin="2,0,7,0"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Taille" Width="86">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="% du parent" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="56" Height="8" Background="{DynamicResource TrackBrush}" CornerRadius="4" VerticalAlignment="Center">
                                                        <Border HorizontalAlignment="Left" Width="{Binding PercentBarWidth}" Background="{DynamicResource AccentGradient}" CornerRadius="4"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding PercentText}" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" FontSize="12"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Sur le disque" Width="92">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding AllocatedText}" Style="{StaticResource MutedNum}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Fichiers" Width="84">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding FilesText}" Style="{StaticResource MutedNum}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Dossiers" Width="76">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding FoldersText}" Style="{StaticResource MutedNum}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Modifié" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource MutedBrush}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </ContentControl>

                    <GridSplitter x:Name="SplitV" Grid.Row="0" Grid.Column="1" Width="16" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                    <ContentControl x:Name="SideCard" Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="0,0,0,8">
                        <TabControl>
                            <TabItem Header="Types">
                                <ListView x:Name="ExtList" SelectionMode="Single" SelectionChanged="ExtList_SelectionChanged" ToolTip="Clique sur un type pour le voir sur la carte">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Extension" Width="120">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Swatch}" Margin="6,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Taille" Width="80">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="%" Width="112">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="56" Height="8" Background="{DynamicResource TrackBrush}" CornerRadius="4" VerticalAlignment="Center">
                                                                <Border HorizontalAlignment="Left" Width="{Binding PercentBarWidth}" Background="{Binding Swatch}" CornerRadius="4"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding PercentText}" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" FontSize="12"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Fichiers" Width="74">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding CountText}" Style="{StaticResource MutedNum}"/></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </TabItem>
                            <TabItem Header="Plus gros fichiers">
                                <ListView x:Name="TopList" SelectionMode="Single" MouseDoubleClick="TopList_MouseDoubleClick"
                                          ContextMenuOpening="List_ContextMenuOpening">
                                    <ListView.ContextMenu><ContextMenu/></ListView.ContextMenu>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Taille" Width="80">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Nom" Width="200">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}" Margin="6,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Dossier" Width="320">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Folder}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Modifié" Width="120">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource MutedBrush}"/></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </TabItem>
                            <TabItem x:Name="SearchTab" Header="Recherche" Visibility="Collapsed">
                                <ListView x:Name="SearchList" SelectionMode="Single" MouseDoubleClick="TopList_MouseDoubleClick"
                                          ContextMenuOpening="List_ContextMenuOpening">
                                    <ListView.ContextMenu><ContextMenu/></ListView.ContextMenu>
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Taille" Width="80">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Nom" Width="200">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}" Margin="6,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Dossier" Width="320">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Folder}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Modifié" Width="120">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource MutedBrush}"/></DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </TabItem>
                        </TabControl>
                    </ContentControl>

                    <GridSplitter x:Name="SplitH" Grid.Row="1" Grid.ColumnSpan="3" Height="16" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                    <ContentControl x:Name="MapCard" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="12,10,12,12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="4,0,0,10">
                                <Button DockPanel.Dock="Right" x:Name="ClearHighlight" Style="{StaticResource PlainButton}" Padding="12,5" Margin="0,0,8,0"
                                        Click="ClearHighlight_Click" Visibility="Collapsed" ToolTip="Afficher à nouveau tous les fichiers">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="ClearHighlightText" Text="Tout afficher" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button DockPanel.Dock="Right" x:Name="UpButton" Style="{StaticResource PlainButton}" Padding="12,5"
                                        Click="UpButton_Click" IsEnabled="False" ToolTip="Revenir au dossier parent">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Dossier parent" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="MapTitle" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                           FontSize="12" Margin="10,0,12,0"/>
                                <StackPanel x:Name="Breadcrumb" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                                    <TextBlock Text="Carte du disque" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                            <Border CornerRadius="8" ClipToBounds="True">
                                <local:TreemapView x:Name="Map"/>
                            </Border>
                        </DockPanel>
                    </ContentControl>
                </Grid>


                <!-- ═════════ Page : Jeux installés ═════════ -->
                <ContentControl x:Name="GamesPage" Grid.Row="2" Style="{StaticResource Card}" Padding="20,16,20,10" Visibility="Collapsed">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="GamesRefresh" Style="{StaticResource PlainButton}" Click="GamesRefresh_Click" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Actualiser"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitle}" Text="Jeux installés"/>
                                <TextBlock x:Name="GamesHint" Style="{StaticResource PageHint}" Margin="0,3,0,0" Text="Recherche des jeux…"/>
                            </StackPanel>
                        </DockPanel>

                        <ListView x:Name="GamesList" SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Jeu" Width="300">
                                        <GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="10" Height="10" CornerRadius="3" Background="{Binding LauncherBrush}" Margin="4,0,9,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Lanceur" Width="110">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Launcher}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Taille" Width="96">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="% des jeux" Width="120">
                                        <GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="56" Height="8" Background="{DynamicResource TrackBrush}" CornerRadius="4" VerticalAlignment="Center"><Border HorizontalAlignment="Left" Width="{Binding BarWidth}" Background="{Binding LauncherBrush}" CornerRadius="4"/></Border><TextBlock Text="{Binding PercentText}" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" FontSize="12"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Dossier" Width="330">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding InstallPath}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="" Width="330">
                                        <GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource LinkButton}" Padding="6,2" Click="GameOpen_Click" Tag="{Binding}" Content="Ouvrir"/>
                                            <Button Style="{StaticResource LinkButton}" Padding="6,2" Click="GameReveal_Click" Tag="{Binding}" Content="Voir dans l'analyse"/>
                                            <Button Style="{StaticResource LinkButton}" Padding="6,2" Click="GameMove_Click" Tag="{Binding}" Content="Déplacer"/>
                                            <Button Style="{StaticResource LinkButton}" Padding="6,2" Click="GameUninstall_Click" Tag="{Binding}" Content="Désinstaller"/>
                                        </StackPanel></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </ContentControl>
                <!-- ═════════ Page : Nettoyage intelligent ═════════ -->
                <ContentControl x:Name="CleanPage" Grid.Row="2" Style="{StaticResource Card}" Padding="20,16,20,10" Visibility="Collapsed">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button x:Name="CleanMeasure" Style="{StaticResource PlainButton}" Click="CleanMeasure_Click" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Recalculer"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CleanRun" Style="{StaticResource AccentButton}" Click="CleanRun_Click" Margin="8,0,0,0" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Nettoyer la sélection"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitle}" Text="Nettoyage intelligent"/>
                                <TextBlock x:Name="CleanHint" Style="{StaticResource PageHint}" Margin="0,3,0,0" Text="Coche ce que tu veux supprimer. Rien n'est coché d'office."/>
                            </StackPanel>
                        </DockPanel>

                        <ListView x:Name="CleanList" SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="" Width="40">
                                        <GridViewColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}" Margin="4,0,0,0"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Catégorie" Width="520">
                                        <GridViewColumn.CellTemplate><DataTemplate><StackPanel Margin="0,3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="500"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Taille" Width="110">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Fichiers" Width="100">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FilesText}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="" Width="260">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </ContentControl>
                <!-- ═════════ Page : Doublons ═════════ -->
                <ContentControl x:Name="DupesPage" Grid.Row="2" Style="{StaticResource Card}" Padding="20,16,20,10" Visibility="Collapsed">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Style="{StaticResource SegmentHost}" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="dupmin" Tag="1" Content="≥ 1 Mo" IsChecked="True" Checked="DupesMin_Checked"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="dupmin" Tag="10" Content="≥ 10 Mo" Checked="DupesMin_Checked"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="dupmin" Tag="100" Content="≥ 100 Mo" Checked="DupesMin_Checked"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="DupesFind" Style="{StaticResource PlainButton}" Click="DupesFind_Click" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Chercher"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DupesAuto" Style="{StaticResource PlainButton}" Click="DupesAuto_Click" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73A;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Cocher les copies"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DupesDelete" Style="{StaticResource AccentButton}" Click="DupesDelete_Click" Margin="8,0,0,0" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Envoyer à la corbeille"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitle}" Text="Doublons"/>
                                <TextBlock x:Name="DupesHint" Style="{StaticResource PageHint}" Margin="0,3,0,0" Text="Lance une analyse, puis cherche les fichiers identiques."/>
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar x:Name="DupesProgress" DockPanel.Dock="Top" Minimum="0" Maximum="1" Margin="0,0,0,10" Visibility="Collapsed"/>
                        <Border DockPanel.Dock="Right" Width="250" Margin="14,0,0,0" CornerRadius="12" Padding="12" Background="{DynamicResource ContentBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Aperçu" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Border Height="200" CornerRadius="8" Background="{DynamicResource TrackBrush}" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock x:Name="DupesPreviewEmpty" Text="Sélectionne un fichier" Foreground="{DynamicResource FaintBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="10"/>
                                        <Image x:Name="DupesPreviewImage" Stretch="Uniform" Margin="4"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="DupesPreviewName" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,2"/>
                                <TextBlock x:Name="DupesPreviewInfo" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                <WrapPanel Margin="-10,8,0,0">
                                    <Button Style="{StaticResource LinkButton}" Content="Ouvrir" Click="PreviewOpen_Click" Tag="Dupes"/>
                                    <Button Style="{StaticResource LinkButton}" Content="Dans l'Explorateur" Click="PreviewReveal_Click" Tag="Dupes"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <ListView x:Name="DupesList" SelectionMode="Single" SelectionChanged="PreviewList_SelectionChanged" MouseDoubleClick="PageList_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="" Width="40">
                                        <GridViewColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}" Visibility="{Binding CheckVisibility}" Margin="4,0,0,0"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Nom" Width="300">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="{Binding NameWeight}" Margin="{Binding Indent}"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Taille" Width="96">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Dossier" Width="420">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Folder}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Modifié" Width="120">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </ContentControl>
                <!-- ═════════ Page : Vieux fichiers ═════════ -->
                <ContentControl x:Name="OldPage" Grid.Row="2" Style="{StaticResource Card}" Padding="20,16,20,10" Visibility="Collapsed">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                <Border Style="{StaticResource SegmentHost}" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="oldage" Tag="1" Content="1 an" IsChecked="True" Checked="OldAge_Checked"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="oldage" Tag="2" Content="2 ans" Checked="OldAge_Checked"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="oldage" Tag="5" Content="5 ans" Checked="OldAge_Checked"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SegmentHost}" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="oldmin" Tag="10" Content="≥ 10 Mo" IsChecked="True" Checked="OldAge_Checked"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="oldmin" Tag="100" Content="≥ 100 Mo" Checked="OldAge_Checked"/>
                                        <RadioButton Style="{StaticResource Segment}" GroupName="oldmin" Tag="1000" Content="≥ 1 Go" Checked="OldAge_Checked"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="OldDelete" Style="{StaticResource AccentButton}" Click="OldDelete_Click" Margin="8,0,0,0" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="Envoyer à la corbeille"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitle}" Text="Vieux fichiers"/>
                                <TextBlock x:Name="OldHint" Style="{StaticResource PageHint}" Margin="0,3,0,0" Text="Gros fichiers que personne n'a modifiés depuis longtemps."/>
                            </StackPanel>
                        </DockPanel>

                        <Border DockPanel.Dock="Right" Width="250" Margin="14,0,0,0" CornerRadius="12" Padding="12" Background="{DynamicResource ContentBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Aperçu" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <Border Height="200" CornerRadius="8" Background="{DynamicResource TrackBrush}" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock x:Name="OldPreviewEmpty" Text="Sélectionne un fichier" Foreground="{DynamicResource FaintBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="10"/>
                                        <Image x:Name="OldPreviewImage" Stretch="Uniform" Margin="4"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="OldPreviewName" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,2"/>
                                <TextBlock x:Name="OldPreviewInfo" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                <WrapPanel Margin="-10,8,0,0">
                                    <Button Style="{StaticResource LinkButton}" Content="Ouvrir" Click="PreviewOpen_Click" Tag="Old"/>
                                    <Button Style="{StaticResource LinkButton}" Content="Dans l'Explorateur" Click="PreviewReveal_Click" Tag="Old"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <ListView x:Name="OldList" SelectionMode="Single" SelectionChanged="PreviewList_SelectionChanged" MouseDoubleClick="PageList_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="" Width="40">
                                        <GridViewColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}" Margin="4,0,0,0"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Nom" Width="280">
                                        <GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}" Margin="2,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Taille" Width="96">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Modifié" Width="120">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Âge" Width="90">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding AgeText}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Dossier" Width="400">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Folder}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </ContentControl>
                <!-- ═════════ Page : Quoi de neuf depuis la dernière analyse ═════════ -->
                <ContentControl x:Name="NewsPage" Grid.Row="2" Style="{StaticResource Card}" Padding="20,16,20,10" Visibility="Collapsed">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">

                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitle}" Text="Quoi de neuf depuis la dernière analyse"/>
                                <TextBlock x:Name="NewsHint" Style="{StaticResource PageHint}" Margin="0,3,0,0" Text="Analyse un disque deux fois pour voir ce qui a changé."/>
                            </StackPanel>
                        </DockPanel>

                        <ListView x:Name="NewsList" SelectionMode="Single" MouseDoubleClick="PageList_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="" Width="36">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" Foreground="{Binding KindBrush}" HorizontalAlignment="Center"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Dossier" Width="480">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Changement" Width="120">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding DeltaText}" Style="{StaticResource Num}" FontWeight="SemiBold" Foreground="{Binding KindBrush}"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Avant" Width="100">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BeforeText}" Style="{StaticResource MutedNum}"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Maintenant" Width="100">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding AfterText}" Style="{StaticResource MutedNum}"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="" Width="140">
                                        <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding KindText}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </ContentControl>


                <!-- ═════════ Page : Fichiers cachés de Windows ═════════ -->
                <ContentControl x:Name="SystemPage" Grid.Row="2" Style="{StaticResource Card}" Padding="20,16,20,14" Visibility="Collapsed">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" x:Name="SystemRefresh" Style="{StaticResource PlainButton}" Click="SystemRefresh_Click" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Actualiser"/>
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitle}" Text="Fichiers cachés de Windows"/>
                                <TextBlock x:Name="SystemHint" Style="{StaticResource PageHint}" Margin="0,3,0,0" Text="Windows garde de gros fichiers invisibles. Voici leur taille et comment les réduire sans risque."/>
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SystemCards"/>
                        </ScrollViewer>
                    </DockPanel>
                </ContentControl>
                <!-- ═════════ Page : Santé des disques ═════════ -->
                <ContentControl x:Name="HealthPage" Grid.Row="2" Style="{StaticResource Card}" Padding="20,16,20,14" Visibility="Collapsed">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" x:Name="HealthRefresh" Style="{StaticResource PlainButton}" Click="HealthRefresh_Click" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="Actualiser"/>
                                </StackPanel>
                            </Button>
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitle}" Text="Santé des disques"/>
                                <TextBlock x:Name="HealthHint" Style="{StaticResource PageHint}" Margin="0,3,0,0" Text="État, température et usure de tes disques, lus directement auprès de Windows."/>
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="HealthCards"/>
                        </ScrollViewer>
                    </DockPanel>
                </ContentControl>

                <DockPanel Grid.Row="3" Margin="4,12,4,0">
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                               Text="Prêt."/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
