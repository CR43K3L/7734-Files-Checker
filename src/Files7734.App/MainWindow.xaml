<Window x:Class="Files7734.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Files7734.App"
        Title="7734 Files Checker" Height="840" Width="1360" MinWidth="860" MinHeight="560"
        Icon="app.ico" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#120E24" Offset="0"/>
            <GradientStop Color="#1B1236" Offset="0.5"/>
            <GradientStop Color="#0B1A2C" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <!-- Taches de couleur floues derrière le verre -->
        <Canvas x:Name="Blobs" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="BlobA" Width="620" Height="520" Canvas.Left="-140" Canvas.Top="-160" Opacity="0.55">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#8B5CF6" Offset="0"/><GradientStop Color="#008B5CF6" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="BlobB" Width="680" Height="560" Opacity="0.40">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#22D3EE" Offset="0"/><GradientStop Color="#0022D3EE" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="BlobC" Width="560" Height="480" Opacity="0.38">
                <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#F472B6" Offset="0"/><GradientStop Color="#00F472B6" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <Grid Margin="16,0,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre de titre : on peut déplacer la fenêtre en la saisissant -->
        <DockPanel Grid.Row="0" Height="66" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,-6,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Réduire"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Agrandir"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fermer"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,26,0">
                <Image Source="app.ico" Width="30" Height="30" Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="7734 Files Checker" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Analyseur d'espace disque" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
                </StackPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <ComboBox x:Name="DriveBox" Width="310" Margin="0,0,10,0" ToolTip="Disque à analyser"/>
                <Button x:Name="ScanButton" Style="{StaticResource AccentButton}" Click="ScanButton_Click" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Scanner"/>
                    </StackPanel>
                </Button>
                <Button x:Name="FolderButton" Style="{StaticResource GlassButton}" Click="FolderButton_Click" Margin="0,0,10,0" ToolTip="Analyser un seul dossier">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Dossier…"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Style="{StaticResource GlassButton}" Click="CancelButton_Click" Visibility="Collapsed" Content="Annuler"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Width="300" Margin="0,0,16,0">
                <TextBlock x:Name="ProgressText" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                <ProgressBar x:Name="Progress" Margin="0,7,0,0" Minimum="0" Maximum="1" Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>

        <!-- Bandeau : pas de droits admin -->
        <Border Grid.Row="1" x:Name="AdminBanner" Background="#26F59E0B" BorderBrush="#66FBBF24" BorderThickness="1" CornerRadius="16"
                Padding="16,8,8,8" Margin="0,0,0,8" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GlassButton}" Padding="12,5" Click="RestartAdmin_Click" Content="Relancer en administrateur"/>
                <TextBlock VerticalAlignment="Center" Foreground="#FDE68A" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold">Mode classique.</Run>
                    <Run x:Name="AdminBannerText">Sans les droits administrateur, le scan est plus lent. Relance l'app en administrateur pour un scan en quelques secondes.</Run>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Contenu -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" MinHeight="140"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="4*" MinHeight="120"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- Arborescence -->
            <ContentControl Grid.Row="0" Grid.Column="0" Style="{StaticResource GlassCard}" Padding="2,4,2,8">
                <ListView x:Name="TreeList" SelectionMode="Single" SelectionChanged="TreeList_SelectionChanged"
                          KeyDown="TreeList_KeyDown" MouseDoubleClick="TreeList_MouseDoubleClick" ContextMenuOpening="List_ContextMenuOpening">
                    <ListView.ContextMenu><ContextMenu/></ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nom" Width="330">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                            <ToggleButton Style="{StaticResource ExpanderToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                          Visibility="{Binding ExpanderVisibility}"/>
                                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" Foreground="{Binding IconBrush}"
                                                       VerticalAlignment="Center" Margin="2,0,7,0"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Taille" Width="86">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="% du parent" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="56" Height="8" Background="{StaticResource TrackBrush}" CornerRadius="4" VerticalAlignment="Center">
                                                <Border HorizontalAlignment="Left" Width="{Binding PercentBarWidth}" Background="{StaticResource AccentGradient}" CornerRadius="4"/>
                                            </Border>
                                            <TextBlock Text="{Binding PercentText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Sur le disque" Width="92">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding AllocatedText}" Style="{StaticResource MutedNum}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Fichiers" Width="84">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding FilesText}" Style="{StaticResource MutedNum}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Dossiers" Width="76">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding FoldersText}" Style="{StaticResource MutedNum}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Modifié" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding ModifiedText}" Foreground="{StaticResource MutedBrush}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </ContentControl>

            <GridSplitter Grid.Row="0" Grid.Column="1" Width="14" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- Onglets : extensions et plus gros fichiers -->
            <ContentControl Grid.Row="0" Grid.Column="2" Style="{StaticResource GlassCard}" Padding="2,0,2,8">
                <TabControl>
                    <TabItem Header="Types de fichiers">
                        <ListView x:Name="ExtList" SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Extension" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Swatch}" Margin="6,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Taille" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="%" Width="118">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="56" Height="8" Background="{StaticResource TrackBrush}" CornerRadius="4" VerticalAlignment="Center">
                                                        <Border HorizontalAlignment="Left" Width="{Binding PercentBarWidth}" Background="{Binding Swatch}" CornerRadius="4"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding PercentText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" FontSize="12"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Fichiers" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding CountText}" Style="{StaticResource MutedNum}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                    <TabItem Header="Plus gros fichiers">
                        <ListView x:Name="TopList" SelectionMode="Single" MouseDoubleClick="TopList_MouseDoubleClick"
                                  ContextMenuOpening="List_ContextMenuOpening">
                            <ListView.ContextMenu><ContextMenu/></ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Taille" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Nom" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}" Margin="6,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Dossier" Width="320">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Folder}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Modifié" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding ModifiedText}" Foreground="{StaticResource MutedBrush}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                </TabControl>
            </ContentControl>

            <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Height="14" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- Carte -->
            <ContentControl Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource GlassCard}" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="6,0,0,8">
                        <Button DockPanel.Dock="Right" x:Name="UpButton" Style="{StaticResource GlassButton}" Padding="12,5"
                                Click="UpButton_Click" IsEnabled="False" ToolTip="Revenir au dossier parent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Dossier parent" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="MapTitle" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="12.5"
                                   TextTrimming="CharacterEllipsis" Text="Carte du disque"/>
                    </DockPanel>
                    <Border CornerRadius="12" x:Name="MapClip" ClipToBounds="True">
                        <local:TreemapView x:Name="Map"/>
                    </Border>
                </DockPanel>
            </ContentControl>
        </Grid>

        <!-- Barre d'état -->
        <DockPanel Grid.Row="3" Margin="6,12,6,0">
            <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource FaintBrush}" FontSize="12"
                       Text="Double-clic sur la carte : zoomer · Clic droit : actions"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
                       Text="Choisis un disque puis clique sur Scanner."/>
        </DockPanel>
        </Grid>
    </Grid>
</Window>
