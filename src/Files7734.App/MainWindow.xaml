<Window x:Class="Files7734.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Files7734.App"
        Title="7734 Files Checker" Height="820" Width="1320" MinWidth="820" MinHeight="520"
        Icon="app.ico" Background="{StaticResource WindowBrush}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barre du haut -->
        <Border Grid.Row="0" Background="{StaticResource TopBarBrush}" Padding="16,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Image Source="app.ico" Width="26" Height="26" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="7734 Files Checker" Foreground="{StaticResource TopBarTextBrush}" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Analyseur d'espace disque" Foreground="#9B96B3" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="DriveBox" Width="290" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,0"
                              ToolTip="Disque à analyser"/>
                    <Button x:Name="ScanButton" Style="{StaticResource AccentButton}" Click="ScanButton_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Scanner"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="FolderButton" Style="{StaticResource GhostButton}" Click="FolderButton_Click" Margin="0,0,8,0"
                            ToolTip="Analyser un seul dossier">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Dossier…"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Click="CancelButton_Click" Visibility="Collapsed" Content="Annuler"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Width="320">
                    <TextBlock x:Name="ProgressText" Foreground="#C9C5DB" FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"/>
                    <ProgressBar x:Name="Progress" Height="4" Margin="0,6,0,0" Minimum="0" Maximum="1" Visibility="Collapsed"
                                 Foreground="{StaticResource AccentSoftBrush}" Background="#2A2638" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bandeau : pas de droits admin -->
        <Border Grid.Row="1" x:Name="AdminBanner" Background="{StaticResource WarningBrush}" Padding="16,8" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LightButton}" Click="RestartAdmin_Click" Content="Relancer en administrateur"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource WarningTextBrush}" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold">Mode classique.</Run>
                    <Run x:Name="AdminBannerText">Sans les droits administrateur, le scan est plus lent. Relance l'app en administrateur pour un scan en quelques secondes.</Run>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Contenu -->
        <Grid Grid.Row="2" Margin="12,12,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" MinHeight="140"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="4*" MinHeight="120"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- Arborescence -->
            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <ListView x:Name="TreeList" Margin="1" SelectionMode="Single" SelectionChanged="TreeList_SelectionChanged"
                          KeyDown="TreeList_KeyDown" MouseDoubleClick="TreeList_MouseDoubleClick" ContextMenuOpening="List_ContextMenuOpening">
                    <ListView.ContextMenu><ContextMenu/></ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Nom" Width="330">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                            <ToggleButton Style="{StaticResource ExpanderToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                          Visibility="{Binding ExpanderVisibility}"/>
                                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" Foreground="{Binding IconBrush}"
                                                       VerticalAlignment="Center" Margin="2,0,7,0"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Taille" Width="86">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="% du parent" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="56" Height="8" Background="#EEEBF5" CornerRadius="4" VerticalAlignment="Center">
                                                <Border HorizontalAlignment="Left" Width="{Binding PercentBarWidth}" Background="{StaticResource AccentBrush}" CornerRadius="4"/>
                                            </Border>
                                            <TextBlock Text="{Binding PercentText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Sur le disque" Width="92">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding AllocatedText}" Style="{StaticResource MutedNum}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Fichiers" Width="84">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding FilesText}" Style="{StaticResource MutedNum}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Dossiers" Width="76">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding FoldersText}" Style="{StaticResource MutedNum}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Modifié" Width="120">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding ModifiedText}" Foreground="{StaticResource MutedBrush}"/></DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <GridSplitter Grid.Row="0" Grid.Column="1" Width="10" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- Onglets : extensions et plus gros fichiers -->
            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TabControl BorderThickness="0" Background="Transparent" Padding="0" Margin="4,2,4,4">
                    <TabItem Header="Types de fichiers">
                        <ListView x:Name="ExtList" SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Extension" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Swatch}" Margin="6,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Taille" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="%" Width="118">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="56" Height="8" Background="#EEEBF5" CornerRadius="4" VerticalAlignment="Center">
                                                        <Border HorizontalAlignment="Left" Width="{Binding PercentBarWidth}" Background="{Binding Swatch}" CornerRadius="4"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding PercentText}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" FontSize="12"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Fichiers" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding CountText}" Style="{StaticResource MutedNum}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                    <TabItem Header="Plus gros fichiers">
                        <ListView x:Name="TopList" SelectionMode="Single" MouseDoubleClick="TopList_MouseDoubleClick"
                                  ContextMenuOpening="List_ContextMenuOpening">
                            <ListView.ContextMenu><ContextMenu/></ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Taille" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" FontWeight="SemiBold"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Nom" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Swatch}" Margin="6,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Dossier" Width="320">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Folder}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Modifié" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding ModifiedText}" Foreground="{StaticResource MutedBrush}"/></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Height="10" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- Carte -->
            <Border Grid.Row="2" Grid.ColumnSpan="3" CornerRadius="8" Background="#1B1A22" ClipToBounds="True">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Background="#221F2C">
                        <Button DockPanel.Dock="Right" x:Name="UpButton" Style="{StaticResource GhostButton}" Padding="10,3" Margin="6,5"
                                Click="UpButton_Click" IsEnabled="False" ToolTip="Revenir au dossier parent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Dossier parent" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="MapTitle" Foreground="#C9C5DB" VerticalAlignment="Center" Margin="12,0" FontSize="12"
                                   TextTrimming="CharacterEllipsis" Text="Carte du disque"/>
                    </DockPanel>
                    <local:TreemapView x:Name="Map"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Barre d'état -->
        <Border Grid.Row="3" Padding="16,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           Text="Double-clic sur la carte : zoomer · Clic droit : actions"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Text="Choisis un disque puis clique sur Scanner."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
